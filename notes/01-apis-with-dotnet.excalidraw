      "link": null,
      "locked": false,
      "text": "ASP.NET MVC \"Core\" is what we use\n    - to build APIs\n    - or MVC style web applications\n    - also includes \"blazor\" (wasm, server, hybrid)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ASP.NET MVC \"Core\" is what we use\n    - to build APIs\n    - or MVC style web applications\n    - also includes \"blazor\" (wasm, server, hybrid)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "NVngRdoreN1TB0W3eSUnN",
      "type": "text",
      "x": 886,
      "y": 1435,
      "width": 912.0794677734375,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aK",
      "roundness": null,
      "seed": 1376316381,
      "version": 208,
      "versionNonce": 225953437,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1776105175536,
      "link": null,
      "locked": false,
      "text": "- .NET Core apis don't need no stinkin' web server. THEY ARE A WEB SERVER (port binding)\n   - web server: RFC 2616 - it knows this stuff. \"Kestrel\"\n    - a program that gets run. ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- .NET Core apis don't need no stinkin' web server. THEY ARE A WEB SERVER (port binding)\n   - web server: RFC 2616 - it knows this stuff. \"Kestrel\"\n    - a program that gets run. ",
      "autoResize": true,
      "lineHeight": 1.25
    }
