    {
      "id": "-Chvy7dkjGgwOXUPAdjXV",
      "type": "text",
      "x": 579,
      "y": 1028,
      "width": 906.2993774414062,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
