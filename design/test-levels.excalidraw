      "boundElements": null,
      "updated": 1776269074616,
      "link": null,
      "locked": false,
      "text": "By having developers write of unit tests\nwe will magically have better quality code.\n",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "By having developers write of unit tests\nwe will magically have better quality code.\n",
