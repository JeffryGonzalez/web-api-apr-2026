    {
      "id": "ZOz-Y860xjhj3jMTnSDPd",
      "type": "text",
      "x": 224,
      "y": 132,
      "width": 1484.9990234375,
      "height": 315,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
