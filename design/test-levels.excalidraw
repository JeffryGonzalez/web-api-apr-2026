      "groupIds": [],
      "frameId": null,
      "index": "a0",
      "roundness": null,
      "seed": 1645265105,
      "version": 447,
      "versionNonce": 668069105,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1776268915898,
      "link": null,
      "locked": false,
      "text": "Unit and Unit Integration Tests\n  - Unit Tests are tests that don't touch database, network or file system.\n   - These are FAST, and promote \"loose coupling\"\n  - Unit integration tests\n    - Still fast, but can test more than one \"unit\", and can\n      touch databases, filesystem, etc. BUT ONLY IF YOUR TEAM OWNS THEM. \n",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Unit and Unit Integration Tests\n  - Unit Tests are tests that don't touch database, network or file system.\n   - These are FAST, and promote \"loose coupling\"\n  - Unit integration tests\n    - Still fast, but can test more than one \"unit\", and can\n      touch databases, filesystem, etc. BUT ONLY IF YOUR TEAM OWNS THEM. \n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "lbHfmVXA7cj1BPOCqs3QL",
      "type": "text",
      "x": 211,
      "y": 446,
      "width": 1663.19873046875,
      "height": 270,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a1",
      "roundness": null,
      "seed": 1738971519,
      "version": 443,
      "versionNonce": 1941007697,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1776269053367,
      "link": null,
      "locked": false,
      "text": "System Tests\n    - Tests that don't fake anything - they are tests that test our app (service)\n        and can use all the stuff we \"own\" \n    - Nothing is \"faked\"?\n    - These demonstrate what the team thinks they have confidence in in the service.\n        - You can release this feature if you want.",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "System Tests\n    - Tests that don't fake anything - they are tests that test our app (service)\n        and can use all the stuff we \"own\" \n    - Nothing is \"faked\"?\n    - These demonstrate what the team thinks they have confidence in in the service.\n        - You can release this feature if you want.",
      "autoResize": true,
      "lineHeight": 1.25
    },
